# systemd unit for horstvideo (cmd/horstvideo) — the video renderer sidecar.
# Drives a headless chromium over a clean /video-stage.html page and stitches
# JPEG frames with ffmpeg. The core horstreporter proxies /api/video/* to it.
#
# Install:
#   sudo cp horstvideo-linux-x64 /opt/horstreporter/ && sudo chown hk:hk /opt/horstreporter/horstvideo-linux-x64
#   sudo cp cmd/horstvideo/horstvideo.service /etc/systemd/system/horstvideo.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now horstvideo
#
# Requires /usr/bin/chromium and /usr/bin/ffmpeg on the host (both present on
# the prod box). No secrets needed — the stage talks to the local HTTPS core
# with -ignore-certificate-errors.
[Unit]
Description=horstvideo time-lapse renderer (chromedp + ffmpeg)
After=network-online.target horstreporter.service
Wants=network-online.target

[Service]
Type=simple
User=hk
Group=hk
WorkingDirectory=/opt/horstreporter
# 9961: 9960 is taken by pathscope on the prod box.
# Backend must be the public domain, not 127.0.0.1: the core's TLS config
# rejects handshakes without matching SNI (alert 80) — chromium's
# --ignore-certificate-errors does not cover a failed handshake.
ExecStart=/opt/horstreporter/horstvideo-linux-x64 -listen 127.0.0.1:9961 -backend https://horstreporter.kgbvax.net -chromium /usr/bin/chromium -work /tmp/horstvideo -out /tmp/horstvideo/out
Restart=on-failure
RestartSec=5
# Chromium's crashpad handler refuses to start ("--database is required")
# when its HOME is unwritable (ProtectHome hides /home) — give it the work dir.
Environment=HOME=/tmp/horstvideo/home
# Single worker: the prod box has 3.7G RAM — one chromium at a time.
# Frame + job retention is pruned by the binary itself (24h).
# hardening — /tmp stays writable under ProtectSystem=strict; the binary
# MkdirAlls /tmp/horstvideo itself (PrivateTmp namespaces it, so no fixed
# ReadWritePaths entry: those are resolved before the dir exists -> 226).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
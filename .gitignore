 If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
horstreporter*

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
.vscode/

# horstprop build artifact (root-anchored so it can't match cmd/horstprop/)
/horstprop-linux-x64

# operator-agent build artifact (root-anchored; `go build ./cmd/horstoperator-agent`)
/horstoperator-agent

# horstawards local award snapshot store (written by the operator agent)
horstawards-data/

# macOS
.DS_Store

# scratch: Chase Queue screenshots/scripts + standalone prototype
tmp/cq-*.png
tmp/cq*.mjs
tmp/dx-cluster-proto/
# Cross-compiled binaries (scripts/build-operator-agent-win64.sh)
dist/

 If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
horstreporter*

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
coverage/
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
.vscode/

# horstprop build artifact (root-anchored so it can't match cmd/horstprop/)
/horstprop-linux-x64

# operator-agent build artifact (root-anchored; `go build ./cmd/horstoperator-agent`)
/horstoperator-agent

# pathscope build artifacts (root-anchored; source lives in cmd/pathscope/)
/pathscope
/pathscope-linux-x64

# removed proplab backtest binary (may be rebuilt by old scripts)
/proplab-backtest-linux-x64

# horstawards local award snapshot store (written by the operator agent)
horstawards-data/

# macOS
.DS_Store

# scratch: Chase Queue screenshots/scripts + standalone prototype
tmp/cq-*.png
tmp/cq*.mjs
tmp/dx-cluster-proto/
# Cross-compiled binaries (scripts/build-operator-agent-win64.sh)
dist/
.compound-engineering/*.local.yaml

test-results/
playwright-report/

# Vite/vitest transient build cache (node_modules is vendored, but this dir is generated)
node_modules/.vite/
dx_baseline.json

# ce-optimize scratch
.context/

# Vite leaves a compiled config copy behind when a build is interrupted
vite.config.js.timestamp-*
